    {
      "parameters": {
        "jsCode": "// Cal.com sends payload inside 'payload' key\nconst body = $input.item.json.body || $input.item.json;\nconst payload = body.payload || body;\n\n// ── Attendee details ──────────────────────────────────\nconst attendee      = (payload.attendees || [])[0] || {};\nconst attendeeEmail = (attendee.email || '').toLowerCase().trim();\nconst attendeeName  = (attendee.name  || '').trim();\nconst attendeeTz    = attendee.timeZone || attendee.timezone || 'UTC';\n\n// ── Booking details ───────────────────────────────────\nconst startTime    = payload.startTime    || '';\nconst endTime      = payload.endTime      || '';\nconst meetingTitle = payload.title        || payload.type || 'Meeting';\nconst calBookingId = payload.uid          || payload.bookingId || '';\n\n// ── Format for Slack display (IST) ───────────────────\nfunction formatTime(isoString, tz) {\n  if (!isoString) return 'N/A';\n  try {\n    return new Date(isoString).toLocaleString('en-IN', {\n      timeZone: tz || 'Asia/Kolkata',\n      weekday:  'short',\n      year:     'numeric',\n      month:    'short',\n      day:      'numeric',\n      hour:     '2-digit',\n      minute:   '2-digit',\n      hour12:   true\n    });\n  } catch(e) {\n    return isoString;\n  }\n}\n\nreturn [{\n  json: {\n    attendee_email:    attendeeEmail,\n    attendee_name:     attendeeName,\n    attendee_timezone: attendeeTz,\n    meeting_title:     meetingTitle,\n    start_time:        startTime,\n    end_time:          endTime,\n    cal_booking_id:    calBookingId,\n    formatted_start:   formatTime(startTime, attendeeTz),\n    formatted_end:     formatTime(endTime, attendeeTz)\n  }\n}];"
      },
