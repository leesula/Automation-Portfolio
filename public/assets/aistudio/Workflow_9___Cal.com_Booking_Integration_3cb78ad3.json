      "parameters": {
        "jsCode": "const payload = $input.item.json.body;\n\n// Cal.com typical payload structure for MEETING_CREATED\nconst attendeeEmail = payload.payload?.attendees?.[0]?.email || '';\nconst attendeeName = payload.payload?.attendees?.[0]?.name || '';\nconst startTime = payload.payload?.startTime || '';\nconst title = payload.payload?.title || 'Meeting';\n\nreturn [{\n  json: {\n    email: attendeeEmail.toLowerCase().trim(),\n    name: attendeeName,\n    start_time: startTime,\n    title: title,\n    raw_payload: payload\n  }\n}];"
      },
