    {
      "parameters": {
        "jsCode": "// Keep these identical to 'Tool - Get Available Slots'\nconst SLOT_MIN = 30, WORK_START = 10, WORK_END = 18, WORK_DAYS = [1,2,3,4,5,6];\nconst OFFSET = 5.5 * 3600 * 1000;\nconst inp = $('Execute Workflow Trigger').first().json;\nconst startMs = Date.parse(inp.start_time);\nif (isNaN(startMs)) throw new Error('INVALID_START_TIME: pass start_time exactly as returned by Get Available Slots (ISO8601 with +05:30).');\nif (startMs < Date.now()) throw new Error('INVALID_START_TIME: that time is in the past. Call Get Available Slots again.');\nconst ist = new Date(startMs + OFFSET);\nconst mins = ist.getUTCHours() * 60 + ist.getUTCMinutes();\nif (!WORK_DAYS.includes(ist.getUTCDay()) || mins < WORK_START * 60 || mins + SLOT_MIN > WORK_END * 60 || mins % SLOT_MIN !== 0)\n  throw new Error('OUTSIDE_BOOKING_RULES: not a valid appointment slot. Call Get Available Slots and use one of its slots.');\nconst endMs = startMs + SLOT_MIN * 60000;\nconst iso = (ms) => new Date(ms + OFFSET).toISOString().slice(0, 19) + '+05:30';\nconst name = (inp.lead_name || 'Lead').trim();\nreturn [{ json: { start_ms: startMs, start_iso: iso(startMs), end_iso: iso(endMs),\n  summary: `Property Viewing - ${name} (Buyer)`, description: inp.description || '', whatsapp_id: inp.whatsapp_id || '' } }];"
      },
