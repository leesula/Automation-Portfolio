      "parameters": {
        "jsCode": "const prep = $('Prepare Booking').first().json;\nconst ev = $input.first().json;\nconst startMs = Date.parse((ev.start && ev.start.dateTime) || '');\nconst ok = !!ev.id && ev.status === 'confirmed' && startMs === prep.start_ms;\nif (!ok) return [{ json: { success: false, verified: false, reason: 'VERIFICATION_FAILED',\n  message: 'The calendar event could not be verified. Do NOT tell the customer the appointment is confirmed. Apologise and say the team will confirm manually.' } }];\nreturn [{ json: { success: true, verified: true, event_id: ev.id, confirmed_start: prep.start_iso, confirmed_end: prep.end_iso,\n  calendar_status: ev.status, calendar_link: ev.htmlLink || '', message: 'Appointment created and verified on the calendar by event ID and start time.' } }];"
      },
