      "parameters": {
        "jsCode": "const message = $input.item.json;\n\n// Extract from email\nconst fromRaw = message.From || message.from || '';\nconst emailMatch = fromRaw.match(/<(.+)>/);\nconst fromEmail = emailMatch\n  ? emailMatch[1].toLowerCase().trim()\n  : fromRaw.toLowerCase().trim();\n\n// Subject\nconst subject = message.Subject\n  || message.subject\n  || '';\n\n// Is reply\nconst isReply = subject.toLowerCase().startsWith('re:');\n\n// Decode HTML entities using a lookup table\nconst htmlEntities = {\n  '&amp;':  '&',\n  '&lt;':   '<',\n  '&gt;':   '>',\n  '&quot;': '\"',\n  '&#39;':  \"'\",\n  '&nbsp;': ' ',\n  '&#33;':  '!',\n  '&#34;':  '\"',\n  '&#35;':  '#',\n  '&#38;':  '&',\n};\n\nfunction decodeHtml(str) {\n  if (!str) return '';\n  // Replace named entities\n  let decoded = str.replace(\n    /&[a-zA-Z]+;|&#\\d+;/g,\n    match => htmlEntities[match] || match\n  );\n  // Replace numeric entities &#39; &#60; etc\n  decoded = decoded.replace(\n    /&#(\\d+);/g,\n    (match, num) => String.fromCharCode(parseInt(num, 10))\n  );\n  return decoded;\n}\n\n// Clean snippet\nconst rawSnippet = message.snippet || '';\n\n// Decode first\nlet cleanSnippet = decodeHtml(rawSnippet);\n\n// Remove quoted original email after \"On [date] wrote:\"\nconst onIndex = cleanSnippet.indexOf(' On ');\nif (onIndex !== -1) {\n  cleanSnippet = cleanSnippet.substring(0, onIndex).trim();\n}\n\n// Remove \"wrote:\" pattern\nconst wroteIndex = cleanSnippet.indexOf('wrote:');\nif (wroteIndex !== -1) {\n  cleanSnippet = cleanSnippet.substring(0, wroteIndex).trim();\n}\n\nreturn [{\n  json: {\n    reply_from:    fromEmail,\n    reply_subject: subject,\n    reply_snippet: cleanSnippet,\n    is_reply:      isReply,\n    received_at:   new Date().toLocaleString('en-IN', {\n      timeZone: 'Asia/Kolkata',\n      year:     'numeric',\n      month:    '2-digit',\n      day:      '2-digit',\n      hour:     '2-digit',\n      minute:   '2-digit',\n      second:   '2-digit',\n      hour12:   false\n    })\n  }\n}];"
      },
