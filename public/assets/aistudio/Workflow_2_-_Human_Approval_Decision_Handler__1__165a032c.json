    {
      "parameters": {
        "jsCode": "// Expected human reply format, typed directly in Slack:\n//   <approval_request_id> | APPROVE | <optional instruction>\n//   <approval_request_id> | REJECT | <reason>\n//\n// The approval_request_id must be included by the human because Slack\n// threads are not a reliable enough key on their own. Workflow 1's Slack\n// notification should print the approval_request_id in its message text\n// so the human can copy it into their reply.\n\nconst text = ($json.text || '').trim();\nconst pattern = /^([a-zA-Z0-9\\-]+)\\s*\\|\\s*(APPROVE|REJECT)\\s*\\|?\\s*(.*)$/i;\nconst match = text.match(pattern);\n\nif (!match) {\n  return [{\n    json: {\n      valid: false,\n      raw_text: text\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    approval_request_id: match[1].trim(),\n    decision: match[2].toUpperCase() === 'APPROVE' ? 'APPROVED' : 'REJECTED',\n    human_instruction: (match[3] || '').trim(),\n    raw_text: text\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        -864,
        -416
      ],
      "id": "ccebd19c-1aad-43ca-abd5-ce79122afac9",
