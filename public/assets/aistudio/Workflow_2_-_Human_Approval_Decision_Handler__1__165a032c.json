      "parameters": {
        "jsCode": "// Deterministic 24-hour WhatsApp customer-service-window check.\n// Based ONLY on the customer's latest inbound message timestamp --\n// never on approval creation time, decision time, or execution time.\n\nconst lead = $('Get Lead').item.json;\nconst lastMsgRaw = lead.last_customer_message_at;\n\nif (!lastMsgRaw) {\n  return [{ json: { ...($json), window_status: 'WITHIN_24_HOURS' } }];\n}\n\nconst lastMsg = new Date(lastMsgRaw);\nconst now = new Date();\nconst hoursElapsed = (now.getTime() - lastMsg.getTime()) / (1000 * 60 * 60);\n\nconst window_status = hoursElapsed <= 24 ? 'WITHIN_24_HOURS' : 'OUTSIDE_24_HOURS';\n\nreturn [{ json: { ...($json), window_status, hours_since_last_customer_message: hoursElapsed } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        896,
        -432
      ],
      "id": "b60564a0-422d-4123-8f5f-f16c0c18abd2",
      "name": "Calculate 24h Window"
    },
    {
      "parameters": {
        "jsCode": "// Deterministic, template-based customer message -- no AI needed here.\n// Never exposes approval_request_id, Supabase/Slack terms, lead score,\n// or HOT/WARM/COLD labels to the customer.\n\nconst decision = $('Parse Human Decision').item.json.decision;\nconst instruction = ($('Parse Human Decision').item.json.human_instruction || '').trim();\n\nlet message;\nif (decision === 'APPROVED') {\n  message = instruction\n    ? `Good news — I checked with our property team and they confirmed: ${instruction}`\n    : `Good news — I checked with our property team and they've confirmed this for you.`;\n} else {\n  message = instruction\n    ? `I checked with our property team, and unfortunately ${instruction}`\n    : `I checked with our property team, and unfortunately this isn't going to be possible right now.`;\n}\n\nreturn [{ json: { ...($json), customer_message: message } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1120,
        -432
      ],
